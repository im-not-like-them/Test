# Base PostgreSQL
DATABASE_URL="postgresql://campus:campus@localhost:5432/campus"

# Domaine racine de la plateforme. Chaque établissement est servi sur <slug>.<ROOT_DOMAIN>.
# En local, les sous-domaines de localhost fonctionnent sans configuration : ul.localhost:3000
ROOT_DOMAIN="localhost:3000"

# "http" en local, "https" en production
PROTOCOL="http"
